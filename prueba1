# Resto del código...
import pandas as pd
import openpyxl
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.formatting.rule import CellIsRule
from openpyxl.utils import get_column_letter

# 1. Cargar datos brutos
df = pd.read_excel('LECTURA_TUBO_6_datos_analizables.xlsx')

# Procesar marcas temporales y cables centrales
df['datetime'] = pd.to_datetime(df['Fecha'].astype(str) + ' ' + df['Hora'].astype(str), errors='coerce')
df = df.sort_values('datetime', ascending=False).reset_index(drop=True)

tq_cols = [c for c in df.columns if c.startswith('TQ_')]
df['TQ_max_C'] = df[tq_cols].max(axis=1)

# 2. Crear Libro de Trabajo
wb = openpyxl.Workbook()

# Hoja 1: Monitoreo Activo
ws1 = wb.active
ws1.title = "Monitoreo_Silo"

# Hoja 2: Parámetros y Umbrales
ws2 = wb.create_sheet(title="Umbrales_Config")

# Poblar Umbrales de Control (Modificables por el usuario)
ws2.append(["Parámetro", "Valor Umbral", "Unidad", "Descripción"])
ws2.append(["UA_Amarillo", 11.5, "%", "Humedad de grano inicio precaución"])
ws2.append(["UA_Naranja", 13.0, "%", "Humedad de grano riesgo elevado"])
ws2.append(["T_Amarillo", 35.0, "°C", "Temp máxima inicio precaución"])
ws2.append(["T_Naranja", 40.0, "°C", "Temp máxima riesgo elevado"])
ws2.append(["T_Rojo", 48.0, "°C", "Temp máxima estado crítico"])
ws2.append(["TQ_Rojo", 42.0, "°C", "Temp cable central estado crítico"])

# Encabezados de Monitoreo
headers = [
    "Fecha", "Hora", "Humedad Grano (UA %)", "Temp Max (°C)", "Temp Min (°C)", 
    "Amplitud T (°C)", "TQ Central Max (°C)", "Temp Amb (°C)", "HR Amb (%)", 
    "Masa (t)", "Alerta Calculada", "Acción Sugerida", "Tendencia Registrada"
]
ws1.append(headers)

# Encabezados con formato visual profesional
header_font = Font(name="Segoe UI", size=11, bold=True, color="FFFFFF")
header_fill = PatternFill(start_color="1F4E78", end_color="1F4E78", fill_type="solid")

for col_num, header in enumerate(headers, 1):
    cell = ws1.cell(row=1, column=col_num)
    cell.font = header_font
    cell.fill = header_fill
    cell.alignment = Alignment(horizontal="center", vertical="center")

# Insertar registros y construir fórmulas dinámicas de Excel
for idx, row in df.head(100).iterrows():
    r = idx + 2 # Fila en Excel
    fecha_str = str(row['Fecha']).split()[0] if pd.notnull(row['Fecha']) else ""
    hora_str = str(row['Hora']) if pd.notnull(row['Hora']) else ""
    
    # Fórmula lógica multivariada referenciada a la pestaña de Umbrales
    formula_alerta = (
        f'=IF(OR(D{r}>=Umbrales_Config!$B$6, G{r}>=Umbrales_Config!$B$7), "ROJO", '
        f'IF(OR(C{r}>Umbrales_Config!$B$3, D{r}>=Umbrales_Config!$B$5), "NARANJA", '
        f'IF(OR(C{r}>Umbrales_Config!$B$2, D{r}>=Umbrales_Config!$B$4), "AMARILLO", "VERDE")))'
    )
    
    # Fórmula para la recomendación operativa inmediata
    formula_accion = (
        f'=IF(K{r}="ROJO", "1° Quitar centro / 2° Secar / 3° Enfriar", '
        f'IF(K{r}="NARANJA", "1° Secar / 2° Enfriar", '
        f'IF(K{r}="AMARILLO", "1° Enfriar", "Monitoreo Normal")))'
    )

    ws1.append([
        fecha_str, hora_str, row['UA_pct'], row['Temp_sensor_max_C'], 
        row['Temp_sensor_min_C'], row['Temp_sensor_amplitud_C'], row['TQ_max_C'], 
        row['Temperatura_ambiente_C'], row['Humedad_relativa_ambiente_pct'], 
        row['Peso_aproximado_t'], formula_alerta, formula_accion, 
        row['Tendencia'] if pd.notnull(row['Tendencia']) else "Sin Dato"
    ])

# Reglas de Formato Condicional (Colores Automáticos)
red_fill = PatternFill(start_color="FFC7CE", end_color="FFC7CE", fill_type="solid")
red_font = Font(color="9C0006", bold=True)
orange_fill = PatternFill(start_color="FFEB9C", end_color="FFEB9C", fill_type="solid")
orange_font = Font(color="9C6500", bold=True)
yellow_fill = PatternFill(start_color="FFF2CC", end_color="FFF2CC", fill_type="solid")
yellow_font = Font(color="7F6000", bold=True)
green_fill = PatternFill(start_color="C6EFCE", end_color="C6EFCE", fill_type="solid")
green_font = Font(color="006100", bold=True)

max_r = len(df.head(100)) + 1
ws1.conditional_formatting.add(f"K2:K{max_r}", CellIsRule(operator='equal', formula=['"ROJO"'], fill=red_fill, font=red_font))
ws1.conditional_formatting.add(f"K2:K{max_r}", CellIsRule(operator='equal', formula=['"NARANJA"'], fill=orange_fill, font=orange_font))
ws1.conditional_formatting.add(f"K2:K{max_r}", CellIsRule(operator='equal', formula=['"AMARILLO"'], fill=yellow_fill, font=yellow_font))
ws1.conditional_formatting.add(f"K2:K{max_r}", CellIsRule(operator='equal', formula=['"VERDE"'], fill=green_fill, font=green_font))

wb.save("Silo_Alertas_Deterioro_Soja.xlsx")
